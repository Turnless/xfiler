# xfiler config. No private keys live here: signing happens inside the
# Binance Agentic Wallet (`baw`). Never put a key or session token in this file.
# Values may be quoted ("x" or 'x'); the quotes are stripped. This file, KILL and DATA_DIR
# are resolved from the project root, not the current directory.

# --- Safety (ported from Cinder: caps, kill-switch, dry-run) ---
# Dry-run is the default. A live trade needs BOTH `--live` on the CLI and LIVE=1 here.
LIVE=0
MAX_USD_PER_FILL=5          # hard cap on a single order, USD
MAX_OPEN_USD=8              # max net stock exposure left in the wallet, USD (unresolved buys count in full)
MAX_FILLS_PER_DAY=12
COOLDOWN_SECONDS=20         # minimum gap between live orders (a sell closing a known buy is exempt)
BUDGET_USD=3                # stop buying when estimated losses (round-trip cost + drift + gas) reach this
KILL_SWITCH_FAIL_CLOSED=true # if the KILL file check itself errors, treat the switch as ON
# Create a file named KILL in the repo root (or set KILL_SWITCH=1 / true / yes) to halt new live orders.

# --- Execution ---
ADAPTER=baw                 # baw | mock (mock is for tests; --live is refused with it)
BAW_BIN=baw
BSC_RPC_URL=https://bsc-dataseed.bnbchain.org
WALLET_ADDRESS=             # your Agentic Wallet BSC address (read-only, used to decode fills); must be a valid 0x address for live runs
SLIPPAGE=1                  # PERCENT passed to baw --slippage (1 = 1%). Must be > 0 and <= 3; "auto" is refused
MAX_QUOTE_SLIPPAGE=0.01     # FRACTION (0.01 = 1%): abort if the quote's own slippage field is above this
BNB_USD=                    # optional BNB price in USD; when set, gas (receipt or BNB balance drop) counts in the loss budget

# --- Data ---
DATA_DIR=data
